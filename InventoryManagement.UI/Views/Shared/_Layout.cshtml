<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Inventory Management UI</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta3/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
<div class="app-wrapper">
    <nav class="app-header navbar navbar-expand bg-body shadow-sm">
        <div class="container-fluid">
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" data-lte-toggle="sidebar" href="#"><i class="fa-solid fa-bars"></i></a></li>
                <li class="nav-item d-none d-md-block"><a asp-controller="Home" asp-action="Index" class="nav-link">Home</a></li>
                <li class="nav-item d-none d-md-block"><a asp-controller="Inventory" asp-action="Index" class="nav-link">Inventories</a></li>
            </ul>
            <form class="d-flex ms-auto me-3 header-search" asp-controller="Search" asp-action="Results" method="get">
                <div class="input-group input-group-sm">
                    <input class="form-control" name="q" placeholder="Search inventories, items, tags..." />
                    <button class="btn btn-primary" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>
            </form>
            <ul class="navbar-nav">
                <li class="nav-item dropdown">
                    <a class="nav-link" data-bs-toggle="dropdown" href="#"><i class="fa-solid fa-language"></i> EN</a>
                    <div class="dropdown-menu dropdown-menu-end">
                        <a class="dropdown-item active" href="#">English</a>
                        <a class="dropdown-item" href="#">Turkish</a>
                    </div>
                </li>
                <li class="nav-item"><a class="nav-link" href="#" id="themeToggle"><i class="fa-solid fa-moon"></i></a></li>
                <li class="nav-item dropdown">
                    <a class="nav-link" data-bs-toggle="dropdown" href="#"><i class="fa-regular fa-user"></i> Alex Morgan</a>
                    <div class="dropdown-menu dropdown-menu-end">
                        <a class="dropdown-item" asp-controller="Profile" asp-action="Index">Profile</a>
                        <a class="dropdown-item" asp-controller="Account" asp-action="Login">Logout</a>
                    </div>
                </li>
            </ul>
        </div>
    </nav>
    <aside class="app-sidebar bg-dark-subtle shadow" data-bs-theme="dark">
        <div class="sidebar-brand">
            <a asp-controller="Home" asp-action="Index" class="brand-link">
                <span class="brand-text fw-bold">Inventory Management</span>
            </a>
        </div>
        <div class="sidebar-wrapper">
            <nav class="mt-2">
                <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="nav-icon fa-solid fa-chart-line"></i><p>Dashboard</p></a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Inventory" asp-action="Index"><i class="nav-icon fa-solid fa-table-list"></i><p>Inventory Catalog</p></a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Inventory" asp-action="Create"><i class="nav-icon fa-solid fa-wand-magic-sparkles"></i><p>Create Wizard</p></a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Inventory" asp-action="Details" asp-route-id="1"><i class="nav-icon fa-solid fa-boxes-stacked"></i><p>Inventory Workspace</p></a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Item" asp-action="Create" asp-route-inventoryId="1"><i class="nav-icon fa-solid fa-plus"></i><p>Add Item to Books</p></a></li>
                    <li class="nav-header">MANAGEMENT</li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Profile" asp-action="Index"><i class="nav-icon fa-solid fa-user-gear"></i><p>My Page</p></a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Users"><i class="nav-icon fa-solid fa-users-gear"></i><p>Admin Users</p></a></li>
                    <li class="nav-header">SYSTEM STATES</li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Error" asp-action="Unauthorized"><i class="nav-icon fa-solid fa-lock"></i><p>401 Unauthorized</p></a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Error" asp-action="Forbidden"><i class="nav-icon fa-solid fa-ban"></i><p>403 Forbidden</p></a></li>
                </ul>
            </nav>
        </div>
    </aside>
    <main class="app-main">
        <div class="app-content-header">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-sm-8"><h3 class="mb-0">@ViewData["Title"]</h3></div>
                    <div class="col-sm-4"><ol class="breadcrumb float-sm-end"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li><li class="breadcrumb-item active">@ViewData["Title"]</li></ol></div>
                </div>
            </div>
        </div>
        <div class="app-content">
            <div class="container-fluid">
                @RenderBody()
            </div>
        </div>
    </main>
    <footer class="app-footer">
        <strong>Inventory Management UI Prototype</strong>
        <div class="float-end d-none d-sm-inline">AdminLTE + ASP.NET Core MVC</div>
    </footer>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta3/dist/js/adminlte.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@{ ViewData["Title"] = "Add Item to Library Books 2026"; }
<div class="item-context-banner mb-3"><div class="d-flex justify-content-between align-items-center"><div><h4 class="mb-1">Adding item to: Library Books 2026</h4><div>Inventory category: Book · Custom ID format: <code class="text-white">BOOK-000184</code> · Write access: Public authenticated users</div></div><a class="btn btn-light" asp-controller="Inventory" asp-action="Details" asp-route-id="1">Back to inventory</a></div></div>
<div class="row g-3"><div class="col-lg-8"><div class="card"><div class="card-header"><h5 class="mb-0">Dynamic item form generated from this inventory fields</h5></div><div class="card-body"><div class="row g-3"><div class="col-md-4"><label class="form-label">Custom ID</label><input class="form-control" value="BOOK-000184"/><div class="form-text">Editable, validated against inventory format.</div></div><div class="col-md-8"><label class="form-label">Title</label><input class="form-control" placeholder="Book title"/></div><div class="col-md-8"><label class="form-label">Authors</label><input class="form-control" placeholder="Author names"/></div><div class="col-md-4"><label class="form-label">Year</label><input class="form-control" type="number" placeholder="2026"/></div><div class="col-12"><label class="form-label">Annotation</label><textarea class="form-control" rows="5" placeholder="Markdown annotation..."></textarea></div><div class="col-md-8"><label class="form-label">Cover / document link</label><input class="form-control" placeholder="https://..."/></div><div class="col-md-4"><label class="form-label">Available</label><div class="form-check form-switch mt-2"><input class="form-check-input" checked type="checkbox"/><label class="form-check-label">Currently available</label></div></div></div><hr/><button class="btn btn-success">Create item</button><button class="btn btn-outline-secondary ms-2">Save draft visually</button></div></div></div><div class="col-lg-4"><div class="card"><div class="card-header"><h5 class="mb-0">Preview</h5></div><div class="card-body"><div class="preview-panel p-3"><div class="text-muted small">Custom ID</div><h5><code>BOOK-000184</code></h5><div class="text-muted small">Table columns shown after save</div><table class="table table-sm mt-2"><tr><th>Title</th><td>...</td></tr><tr><th>Authors</th><td>...</td></tr><tr><th>Year</th><td>...</td></tr></table></div></div></div></div></div>

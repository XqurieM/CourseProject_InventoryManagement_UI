@{ ViewData["Title"] = "Inventory Catalog"; }
<div class="card mb-3"><div class="card-body"><div class="row g-2"><div class="col-md-4"><input class="form-control" placeholder="Search by title, description or tag" /></div><div class="col-md-2"><select class="form-select"><option>All categories</option><option>Equipment</option><option>Book</option><option>Furniture</option><option>Document</option></select></div><div class="col-md-2"><select class="form-select"><option>All access</option><option>Public write</option><option>Private</option></select></div><div class="col-md-2"><select class="form-select"><option>Newest</option><option>Most items</option><option>A-Z</option></select></div><div class="col-md-2"><a class="btn btn-primary w-100" asp-action="Create">Create</a></div></div></div></div>
<div class="card"><div class="card-header"><h5 class="mb-0">All inventories</h5></div><div class="card-body table-responsive p-0"><table class="table table-hover mb-0"><thead><tr><th>Title</th><th>Description</th><th>Category</th><th>Creator</th><th>Tags</th><th>Items</th><th>Updated</th></tr></thead><tbody>
<tr><td><a asp-action="Details" asp-route-id="1" class="fw-bold">Library Books 2026</a></td><td>Custom book catalog with author, year and annotation fields.</td><td>Book</td><td>Nora Stone</td><td><span class="badge badge-soft">books</span> <span class="badge badge-soft">library</span></td><td>942</td><td>Today</td></tr>
<tr><td><a asp-action="Details" asp-route-id="2" class="fw-bold">Office Equipment</a></td><td>Managed asset list for laptops, monitors and accessories.</td><td>Equipment</td><td>Alex Morgan</td><td><span class="badge badge-soft">hardware</span></td><td>315</td><td>Yesterday</td></tr>
<tr><td><a asp-action="Details" asp-route-id="3" class="fw-bold">Furniture Registry</a></td><td>Rooms, floors, purchase dates and condition tracking.</td><td>Furniture</td><td>Admin Team</td><td><span class="badge badge-soft">furniture</span></td><td>188</td><td>Apr 28</td></tr>
</tbody></table></div></div>

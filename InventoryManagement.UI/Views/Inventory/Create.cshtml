@model InventoryCreatePageViewModel
@{
    ViewData["Title"] = Html.T("title", "Create Inventory");
}
<div class="alert alert-info">
    <i class="fa-solid fa-circle-info me-2"></i>
    @Html.T("info", "This page creates the base inventory first. After that, fields, custom ID rules and access settings continue in the inventory workspace.")
</div>
<form asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <div class="col-xl-8">
            <div class="card mb-3">
                <div class="card-header"><h5 class="mb-0">@Html.T("general.title", "General settings")</h5></div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">@Html.T("form.title", "Inventory title")</label>
                            <input asp-for="Form.Title" class="form-control form-control-lg" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@Html.T("form.category", "Category")</label>
                            <select asp-for="Form.CategoryId" class="form-select form-select-lg">
                                <option value="">@Html.T("form.category.placeholder", "Select category")</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                            @if (!string.IsNullOrWhiteSpace(Model.CategoriesHelpText))
                            {
                                <div class="form-text">@Model.CategoriesHelpText</div>
                            }
                        </div>
                        <div class="col-12">
                            <label class="form-label">@Html.T("form.description", "Description")</label>
                            <textarea asp-for="Form.Description" class="form-control" rows="5"></textarea>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">@Html.T("form.imageUrl", "Illustration URL")</label>
                            <input asp-for="Form.ImageUrl" class="form-control" id="inventoryImageUrlInput" placeholder="https://..." />
                            <div class="form-text">If you paste a URL, it will be used directly. If you choose a file, it is uploaded to Google Drive first and the returned public URL is saved.</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Upload image</label>
                            <input asp-for="UploadedImage" type="file" accept="image/*" class="form-control" id="inventoryImageFileInput" />
                            <div class="form-text">Recommended when you want the system to upload the file for you. File upload takes priority over the URL field.</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">@Html.T("form.visibility", "Write access")</label>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <input class="btn-check" type="radio" name="Form.IsPublic" id="createVisibilityRestricted" value="false" checked="@(!Model.Form.IsPublic)" />
                                    <label class="card h-100 border-2 shadow-sm access-mode-card @(Model.Form.IsPublic ? "" : "border-primary")" for="createVisibilityRestricted">
                                        <div class="card-body">
                                            <div class="fw-semibold mb-1">@Html.T("form.visibility.restricted", "Only owner and admins")</div>
                                            <div class="small text-muted">@Html.T("form.visibility.restrictedHelp", "Inventory settings and item writing stay limited to the main managers.")</div>
                                        </div>
                                    </label>
                                </div>
                                <div class="col-md-6">
                                    <input class="btn-check" type="radio" name="Form.IsPublic" id="createVisibilityShared" value="true" checked="@(Model.Form.IsPublic)" />
                                    <label class="card h-100 border-2 shadow-sm access-mode-card @(Model.Form.IsPublic ? "border-primary" : "")" for="createVisibilityShared">
                                        <div class="card-body">
                                            <div class="fw-semibold mb-1">@Html.T("form.visibility.shared", "Allow authenticated item writers")</div>
                                            <div class="small text-muted">@Html.T("form.visibility.sharedHelp", "Signed-in users can add and update items, while settings stay with owner/admin.")</div>
                                        </div>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card sticky-top" style="top:1rem">
                <div class="card-header"><h5 class="mb-0">@Html.T("review.title", "Review")</h5></div>
                <div class="card-body">
                    <div class="rounded overflow-hidden border mb-3 bg-light d-flex align-items-center justify-content-center" style="aspect-ratio: 16/10;">
                        <img id="inventoryCreatePreviewImage"
                             src="@(string.IsNullOrWhiteSpace(Model.Form.ImageUrl) ? "" : Model.Form.ImageUrl)"
                             alt="Inventory preview"
                             style="width:100%;height:100%;object-fit:cover;display:@(string.IsNullOrWhiteSpace(Model.Form.ImageUrl) ? "none" : "block")" />
                        <div id="inventoryCreatePreviewPlaceholder" class="text-center text-muted px-3" style="display:@(string.IsNullOrWhiteSpace(Model.Form.ImageUrl) ? "block" : "none")">
                            <i class="fa-solid fa-image fa-2x mb-2"></i>
                            <div>Image preview will appear here.</div>
                        </div>
                    </div>
                    <dl class="row">
                        <dt class="col-5">@Html.T("review.titleLabel", "Title")</dt><dd class="col-7">@(!string.IsNullOrWhiteSpace(Model.Form.Title) ? Model.Form.Title : "-")</dd>
                        <dt class="col-5">@Html.T("review.categoryLabel", "Category")</dt><dd class="col-7">@Model.Categories.FirstOrDefault(x => x.Id == Model.Form.CategoryId)?.Name</dd>
                        <dt class="col-5">@Html.T("review.visibilityLabel", "Write access")</dt><dd class="col-7">@(Model.Form.IsPublic ? Html.T("form.visibility.shared", "Allow authenticated item writers") : Html.T("form.visibility.restricted", "Only owner and admins"))</dd>
                    </dl>
                    <button class="btn btn-success w-100" type="submit">@Html.T("actions.create", "Create Inventory")</button>
                    <a class="btn btn-outline-secondary w-100 mt-2" asp-action="Index">@Html.T("actions.cancel", "Cancel")</a>
                </div>
            </div>
        </div>
    </div>
</form>

      <tr><td><a asp-controller="Inventory" asp-action="Details" asp-route-id="2" class="fw-semibold">Office Equipment</a><div class="text-muted small">Laptops, monitors, printers and accessories</div></td><td>Equipment</td><td>Alex Morgan</td><td><span class="badge badge-soft">office</span> <span class="badge badge-soft">hardware</span></td><td>315</td><td><span class="badge text-bg-secondary">Private</span></td></tr>
      <tr><td><a asp-controller="Inventory" asp-action="Details" asp-route-id="3" class="fw-semibold">HR Documents Archive</a><div class="text-muted small">Internal document tracking</div></td><td>Document</td><td>Mehmet Kaya</td><td><span class="badge badge-soft">hr</span> <span class="badge badge-soft">docs</span></td><td>77</td><td><span class="badge text-bg-secondary">Private</span></td></tr>

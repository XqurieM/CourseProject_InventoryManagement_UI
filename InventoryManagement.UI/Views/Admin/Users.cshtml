@{
    ViewData["Title"] = "Admin User Management";
}
<div class="card mb-3"><div class="card-body"><div class="row g-2"><div class="col-md-4"><input class="form-control" placeholder="Search user by name or email" /></div><div class="col-md-2"><select class="form-select"><option>All roles</option><option>Admin</option><option>User</option></select></div><div class="col-md-2"><select class="form-select"><option>All statuses</option><option>Active</option><option>Blocked</option></select></div><div class="col-md-2"><select class="form-select"><option>Sort by name</option><option>Sort by email</option><option>Newest</option></select></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Apply</button></div></div></div></div>
<div class="card"><div class="card-header"><h5 class="mb-0">Users</h5></div><div class="card-body table-responsive p-0"><table class="table table-hover mb-0"><thead><tr><th>User</th><th>Email</th><th>Role</th><th>Status</th><th>Owned inventories</th><th>Writable access</th><th>Admin actions</th></tr></thead><tbody><tr><td><a asp-controller="Profile" asp-action="Index">Alex Morgan</a></td><td>alex@example.com</td><td><span class="badge text-bg-danger">Admin</span></td><td><span class="badge text-bg-success">Active</span></td><td>12</td><td>38</td><td><div class="btn-group btn-group-sm"><button class="btn btn-outline-warning">Block</button><button class="btn btn-outline-secondary">Revoke admin</button><button class="btn btn-outline-danger">Delete</button></div></td></tr><tr><td>Nora Stone</td><td>nora@example.com</td><td>User</td><td><span class="badge text-bg-success">Active</span></td><td>4</td><td>18</td><td><div class="btn-group btn-group-sm"><button class="btn btn-outline-warning">Block</button><button class="btn btn-outline-primary">Grant admin</button><button class="btn btn-outline-danger">Delete</button></div></td></tr><tr><td>Blocked User</td><td>blocked@example.com</td><td>User</td><td><span class="badge text-bg-dark">Blocked</span></td><td>0</td><td>0</td><td><div class="btn-group btn-group-sm"><button class="btn btn-outline-success">Unblock</button><button class="btn btn-outline-primary">Grant admin</button><button class="btn btn-outline-danger">Delete</button></div></td></tr></tbody></table></div></div>
<div class="alert alert-warning mt-3"><b>Design note:</b> Admin can revoke their own admin role, as required. Buttons are visible in UI and can be wired later.</div>

@model BatchItemEditPageViewModel
@{
    ViewData["Title"] = "Complete Item Values";
}
<div class="item-context-banner mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h4 class="mb-1">@Model.InventoryTitle</h4>
            <div>@Model.Items.Count item(s) waiting for field values</div>
        </div>
        <a class="btn btn-light" asp-controller="Inventory" asp-action="Details" asp-route-id="@Model.InventoryId">Back to inventory</a>
    </div>
</div>
<div class="card">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        @if (!string.IsNullOrWhiteSpace(Model.HelperText))
        {
            <div class="alert alert-light border">@Model.HelperText</div>
        }
        <form asp-action="BulkEdit" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="InventoryId" type="hidden" />
            <input asp-for="InventoryTitle" type="hidden" />
            <div class="accordion" id="bulkItemEditor">
                @for (var i = 0; i < Model.Items.Count; i++)
                {
                    <input asp-for="Items[i].ItemId" type="hidden" />
                    <input asp-for="Items[i].ItemName" type="hidden" />
                    <input asp-for="Items[i].CustomId" type="hidden" />
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button @(i == 0 ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#item-panel-@i">
                                @Model.Items[i].ItemName <span class="ms-2 text-muted small">@Model.Items[i].CustomId</span>
                            </button>
                        </h2>
                        <div id="item-panel-@i" class="accordion-collapse collapse @(i == 0 ? "show" : "")" data-bs-parent="#bulkItemEditor">
                            <div class="accordion-body">
                                <div class="row g-3">
                                @for (var j = 0; j < Model.Items[i].Fields.Count; j++)
                                {
                                    <input asp-for="Items[i].Fields[j].InventoryFieldId" type="hidden" />
                                    <input asp-for="Items[i].Fields[j].Label" type="hidden" />
                                    <input asp-for="Items[i].Fields[j].Description" type="hidden" />
                                    <input asp-for="Items[i].Fields[j].FieldType" type="hidden" />
                                    <input asp-for="Items[i].Fields[j].DisplayOrder" type="hidden" />
                                    <input asp-for="Items[i].Fields[j].IsRequired" type="hidden" />
                                    <input asp-for="Items[i].Fields[j].ShowInTable" type="hidden" />
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">@Model.Items[i].Fields[j].Label</label>
                                        @if (!string.IsNullOrWhiteSpace(Model.Items[i].Fields[j].Description))
                                        {
                                            <div class="small text-muted mb-2">@Model.Items[i].Fields[j].Description</div>
                                        }
                                        @switch (Model.Items[i].Fields[j].FieldType)
                                        {
                                            case InventoryFieldType.Number:
                                                <input asp-for="Items[i].Fields[j].NumberValue" class="form-control" />
                                                break;
                                            case InventoryFieldType.Boolean:
                                                <div class="form-check form-switch mt-2">
                                                    <input asp-for="Items[i].Fields[j].BooleanValue" class="form-check-input" />
                                                    <label asp-for="Items[i].Fields[j].BooleanValue" class="form-check-label">True / False</label>
                                                </div>
                                                break;
                                            default:
                                                <input asp-for="Items[i].Fields[j].StringValue" class="form-control" />
                                                break;
                                        }
                                    </div>
                                }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <button class="btn btn-success mt-4" type="submit">Save all item values</button>
        </form>
    </div>
</div>

@{ ViewData["Title"] = "Inventory Workspace"; }
<div class="row g-3 mb-3"><div class="col-lg-8"><div class="card"><div class="card-body"><div class="d-flex align-items-start gap-3"><div class="rounded bg-primary text-white d-flex align-items-center justify-content-center" style="width:72px;height:72px"><i class="fa-solid fa-book fa-2x"></i></div><div class="flex-grow-1"><h3 class="mb-1">Library Books 2026</h3><p class="text-muted mb-2">Shared book inventory with custom number rules, configurable fields, discussion, likes and item statistics.</p><span class="badge text-bg-primary">Book</span> <span class="badge badge-soft">books</span> <span class="badge badge-soft">library</span> <span class="badge text-bg-success">Public write</span></div><div class="text-end"><a class="btn btn-primary" asp-controller="Item" asp-action="Create" asp-route-inventoryId="1"><i class="fa-solid fa-plus me-1"></i>Add item to this inventory</a><div class="small text-muted mt-2">Owner: Nora Stone</div></div></div></div></div></div><div class="col-lg-4"><div class="card"><div class="card-body"><div class="row text-center"><div class="col"><div class="fs-3 fw-bold">942</div><div class="small text-muted">Items</div></div><div class="col"><div class="fs-3 fw-bold">4</div><div class="small text-muted">Fields</div></div><div class="col"><div class="fs-3 fw-bold">128</div><div class="small text-muted">Likes</div></div></div></div></div></div></div>
<div class="card"><div class="card-header p-0"><ul class="nav nav-tabs card-header-tabs px-3 pt-3" role="tablist"><li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#items">Items</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#discussion">Discussion</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#settings">General settings</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#customid">Custom ID</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#access">Access</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#fields">Fields</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#stats">Stats</button></li></ul></div><div class="card-body tab-content">
<div class="tab-pane fade show active" id="items"><div class="d-flex justify-content-between mb-3"><div class="input-group w-50"><input class="form-control" placeholder="Filter items in this inventory..."/><button class="btn btn-outline-secondary">Filter</button></div><a class="btn btn-primary" asp-controller="Item" asp-action="Create" asp-route-inventoryId="1">Add item</a></div><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Custom ID</th><th>Title</th><th>Authors</th><th>Year</th><th>Created by</th><th>Likes</th><th>Updated</th></tr></thead><tbody><tr><td><a asp-controller="Item" asp-action="Details" asp-route-id="1"><code>BOOK-000184</code></a></td><td>Clean Code</td><td>Robert C. Martin</td><td>2008</td><td>Nora Stone</td><td><i class="fa-solid fa-heart text-danger"></i> 24</td><td>Today</td></tr><tr><td><a asp-controller="Item" asp-action="Details" asp-route-id="2"><code>BOOK-000185</code></a></td><td>Domain-Driven Design</td><td>Eric Evans</td><td>2003</td><td>Alex Morgan</td><td><i class="fa-regular fa-heart"></i> 16</td><td>Yesterday</td></tr><tr><td><a asp-controller="Item" asp-action="Details" asp-route-id="3"><code>BOOK-000186</code></a></td><td>Refactoring</td><td>Martin Fowler</td><td>2018</td><td>Mehmet Kaya</td><td><i class="fa-regular fa-heart"></i> 31</td><td>Apr 29</td></tr></tbody></table></div><div class="small text-muted">Table rows link to item detail/edit pages. No row action buttons, matching the PDF guideline.</div></div>
<div class="tab-pane fade" id="discussion"><div class="alert alert-light border"><i class="fa-solid fa-bolt me-1"></i>Near-real-time discussion placeholder. Later this area can be backed by SignalR polling or hub updates.</div><div class="discussion-post"><div class="d-flex justify-content-between"><b><a asp-controller="Profile" asp-action="Index">Nora Stone</a></b><span class="text-muted small">Today 10:24</span></div><p class="mb-0">Please keep the <b>Year</b> field numeric and use the document link field only for official preview links.</p></div><div class="discussion-post"><div class="d-flex justify-content-between"><b>Alex Morgan</b><span class="text-muted small">Today 10:31</span></div><p class="mb-0">Added three architecture books. Custom IDs were generated correctly.</p></div><textarea class="form-control" rows="4" placeholder="Write Markdown comment..."></textarea><button class="btn btn-primary mt-2">Post comment</button></div>
<div class="tab-pane fade" id="settings"><div class="row g-3"><div class="col-md-8"><label class="form-label">Title</label><input class="form-control" value="Library Books 2026"/><label class="form-label mt-3">Description</label><textarea class="form-control" rows="6">Shared book inventory with Markdown description.</textarea></div><div class="col-md-4"><label class="form-label">Category</label><select class="form-select"><option selected>Book</option><option>Equipment</option></select><label class="form-label mt-3">Image URL</label><input class="form-control" value="https://cdn.example.com/library-cover.jpg"/><div class="form-check form-switch mt-3"><input class="form-check-input" checked type="checkbox"/><label class="form-check-label">Public write access</label></div><button class="btn btn-success mt-3 w-100">Auto-save now</button><div class="small text-muted mt-2">Auto-save design: save every 7-10 seconds with optimistic lock version.</div></div></div></div>
<div class="tab-pane fade" id="customid"><div class="row g-3"><div class="col-lg-8"><div data-sortable="true" class="d-grid gap-2"><div class="rule-card"><i class="rule-handle fa-solid fa-grip-vertical me-2"></i><b>Fixed text</b> <code>BOOK-</code></div><div class="rule-card"><i class="rule-handle fa-solid fa-grip-vertical me-2"></i><b>Sequence</b> <code>D6</code></div><div class="rule-card"><i class="rule-handle fa-solid fa-grip-vertical me-2"></i><b>Date/time</b> <code>yyyy</code></div></div></div><div class="col-lg-4"><div class="preview-id">BOOK-000184-2026</div><button class="btn btn-outline-primary mt-3 w-100">Add ID element</button></div></div></div>
<div class="tab-pane fade" id="access"><div class="row g-3"><div class="col-md-7"><input class="form-control mb-2" placeholder="Autocomplete by name or email..."/><div class="access-user d-flex justify-content-between mb-2"><div><b>Nora Stone</b><div class="small text-muted">nora.stone@example.com</div></div><span class="badge text-bg-success">Owner</span></div><div class="access-user d-flex justify-content-between"><div><b>Mehmet Kaya</b><div class="small text-muted">mehmet.kaya@example.com</div></div><button class="btn btn-sm btn-outline-danger">Remove</button></div></div><div class="col-md-5"><div class="form-check form-switch"><input class="form-check-input" checked type="checkbox"/><label class="form-check-label">All authenticated users can write</label></div><select class="form-select mt-3"><option>Sort users by name</option><option>Sort users by email</option></select></div></div></div>
<div class="tab-pane fade" id="fields"><div class="d-grid gap-2" data-sortable="true"><div class="field-card"><i class="field-handle fa-solid fa-grip-vertical me-2"></i><b>Title</b> - Single-line text - shown in table</div><div class="field-card"><i class="field-handle fa-solid fa-grip-vertical me-2"></i><b>Authors</b> - Single-line text - shown in table</div><div class="field-card"><i class="field-handle fa-solid fa-grip-vertical me-2"></i><b>Year</b> - Numeric - shown in table</div><div class="field-card"><i class="field-handle fa-solid fa-grip-vertical me-2"></i><b>Annotation</b> - Multiline - detail only</div><div class="field-card"><i class="field-handle fa-solid fa-grip-vertical me-2"></i><b>Cover / Document link</b> - Link - detail only</div></div><button class="btn btn-outline-primary mt-3">Add custom field</button></div>
<div class="tab-pane fade" id="stats"><div class="row g-3"><div class="col-md-4"><div class="card border"><div class="card-body"><h6>Item count</h6><div class="display-6">942</div></div></div></div><div class="col-md-4"><div class="card border"><div class="card-body"><h6>Year average</h6><div class="display-6">2012</div><div class="small text-muted">Range: 1954 - 2026</div></div></div></div><div class="col-md-4"><div class="card border"><div class="card-body"><h6>Most used author</h6><div class="display-6">Martin</div><div class="small text-muted">42 occurrences</div></div></div></div></div></div>
</div></div>

@model RegisterPageViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="@(((ViewData["LocalizationState"] as UiLocalizationViewModel)?.LanguageCode) ?? "tr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Html.T("title", "Register")</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow border-0 rounded-4">
                    <div class="card-body p-5">
                        <h2>@Html.T("hero.title", "Create account")</h2>
                        <p class="text-muted">@Html.T("hero.subtitle", "Register with the backend auth service.")</p>
                        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger">@Model.ErrorMessage</div>
                        }
                        <form asp-action="Register" method="post">
                            @Html.AntiForgeryToken()
                            <input asp-for="Form.UserName" class="form-control mb-3" placeholder="@Html.T("form.username", "User name")" />
                            <span asp-validation-for="Form.UserName" class="text-danger small"></span>
                            <input asp-for="Form.Email" class="form-control mb-3" placeholder="@Html.T("form.email", "Email")" />
                            <span asp-validation-for="Form.Email" class="text-danger small"></span>
                            <input asp-for="Form.Password" class="form-control mb-3" type="password" placeholder="@Html.T("form.password", "Password")" />
                            <span asp-validation-for="Form.Password" class="text-danger small"></span>
                            <input asp-for="ConfirmPassword" class="form-control mb-3" type="password" placeholder="@Html.T("form.confirmPassword", "Confirm password")" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            <button class="btn btn-success w-100" type="submit">@Html.T("form.submit", "Create account")</button>
                        </form>
                        <a class="d-block mt-3" asp-action="Login">@Html.T("link.login", "Back to login")</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

@{
    var layoutState = ViewData["LayoutState"] as LayoutViewModel ?? new LayoutViewModel();
    ViewData["Title"] ??= "Inventory Management";
    var isEnglish = ((ViewData["LocalizationState"] as UiLocalizationViewModel)?.LanguageCode ?? "tr").ToLower().StartsWith("en");
}
<!DOCTYPE html>
<html lang="@(((ViewData["LocalizationState"] as UiLocalizationViewModel)?.LanguageCode) ?? "tr")" data-bs-theme="@(layoutState.User?.PreferredTheme == ThemeType.Dark ? "dark" : "light")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @Html.T("shared.app.name", "Inventory Management UI")</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta3/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
<div class="app-wrapper">
    <nav class="app-header navbar navbar-expand bg-body shadow-sm">
        <div class="container-fluid">
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" data-lte-toggle="sidebar" href="#"><i class="fa-solid fa-bars"></i></a></li>
                <li class="nav-item d-none d-md-block"><a asp-controller="Home" asp-action="Index" class="nav-link">@Html.T("nav.home", "Home")</a></li>
                <li class="nav-item d-none d-md-block"><a asp-controller="Inventory" asp-action="Index" class="nav-link">@Html.T("nav.inventories", "Inventories")</a></li>
            </ul>
            <form class="d-flex ms-auto me-3 header-search" asp-controller="Search" asp-action="Results" method="get">
                <div class="input-group input-group-sm">
                    <input class="form-control" name="q" placeholder="@Html.T("search.placeholder", "Search inventories, items, tags...")" value="@(Context.Request.Query["q"])" />
                    <button class="btn btn-primary" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>
            </form>
            <ul class="navbar-nav header-actions">
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center gap-2" asp-controller="Profile" asp-action="Index">
                        <i class="fa-solid fa-language"></i>
                        <span class="header-action-text">@(layoutState.User?.PreferredLanguage.ToString() ?? "Language")</span>
                    </a>
                </li>
                <li class="nav-item"><a class="nav-link" href="#" id="themeToggle"><i class="fa-solid fa-circle-half-stroke"></i></a></li>
                <li class="nav-item dropdown">
                    <a class="nav-link d-flex align-items-center gap-2" data-bs-toggle="dropdown" href="#">
                        <i class="fa-regular fa-user"></i>
                        <span class="header-user-text">@layoutState.DisplayName</span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end">
                        @if (layoutState.IsAuthenticated)
                        {
                            <a class="dropdown-item" asp-controller="Profile" asp-action="Index">@Html.T("profile.title", "Profile")</a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="px-3 py-1">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-link dropdown-item px-0" type="submit">@Html.T("auth.logout", "Logout")</button>
                            </form>
                        }
                        else
                        {
                            <a class="dropdown-item" asp-controller="Account" asp-action="Login">@Html.T("auth.login", "Login")</a>
                        }
                    </div>
                </li>
            </ul>
        </div>
    </nav>
    <aside class="app-sidebar bg-dark-subtle shadow" data-bs-theme="dark">
        <div class="sidebar-brand">
            <a asp-controller="Home" asp-action="Index" class="brand-link">
                <span class="brand-text fw-bold">Inventory Management</span>
            </a>
        </div>
        <div class="sidebar-wrapper">
            <nav class="mt-2">
                <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="nav-icon fa-solid fa-chart-line"></i><p>@Html.T("dashboard.title", "Dashboard")</p></a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Inventory" asp-action="Index"><i class="nav-icon fa-solid fa-table-list"></i><p>@Html.T("inventory.catalog.title", "Inventory Catalog")</p></a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Inventory" asp-action="Create"><i class="nav-icon fa-solid fa-wand-magic-sparkles"></i><p>@Html.T("inventory.create.title", "Create Inventory")</p></a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Search" asp-action="Results"><i class="nav-icon fa-solid fa-magnifying-glass"></i><p>@Html.T("search.title", "Search")</p></a></li>
                    <li class="nav-header">@Html.T("section.management", "MANAGEMENT")</li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Profile" asp-action="Index"><i class="nav-icon fa-solid fa-user-gear"></i><p>@Html.T("profile.page.title", "My Page")</p></a></li>
                    @if (layoutState.User?.IsAdmin == true)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Users"><i class="nav-icon fa-solid fa-users-gear"></i><p>@Html.T("admin.users.title", "Admin Users")</p></a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Categories"><i class="nav-icon fa-solid fa-layer-group"></i><p>Categories</p></a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Tags"><i class="nav-icon fa-solid fa-tags"></i><p>Tags</p></a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Localization"><i class="nav-icon fa-solid fa-language"></i><p>Localization</p></a></li>
                    }
                </ul>
            </nav>
        </div>
    </aside>
    <main class="app-main">
        <div class="app-content-header">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-sm-8"><h3 class="mb-0">@ViewData["Title"]</h3></div>
                    <div class="col-sm-4"><ol class="breadcrumb float-sm-end"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">@Html.T("nav.home", "Home")</a></li><li class="breadcrumb-item active">@ViewData["Title"]</li></ol></div>
                </div>
            </div>
        </div>
        <div class="app-content">
            <div class="container-fluid">
                @if (TempData["SuccessMessage"] is string successMessage)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @successMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] is string errorMessage)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @errorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </div>
    </main>
    <footer class="app-footer">
        <strong>@Html.T("shared.app.name", "Inventory Management UI")</strong>
        <a href="#" id="createSupportTicketLink" class="text-decoration-none ms-3 text-secondary" style="font-size: 0.9rem;">
            <i class="fa-solid fa-circle-question me-1"></i> @(isEnglish ? "Create Support Ticket" : "Destek Talebi Oluştur")
        </a>
        <div class="float-end d-none d-sm-inline">@Html.T("shared.footer.stack", "AdminLTE + ASP.NET Core MVC")</div>
    </footer>
</div>

<!-- Floating Help Button -->
<div class="position-fixed bottom-0 end-0 m-4 z-3">
    <button class="btn btn-primary rounded-circle shadow-lg d-flex align-items-center justify-content-center" id="floatingHelpButton" style="width: 55px; height: 55px; font-size: 24px; transition: all 0.3s ease;" title="@(isEnglish ? "Create Support Ticket" : "Destek Talebi Oluştur")">
        <i class="fa-solid fa-headset"></i>
    </button>
</div>

<!-- Support Ticket Modal -->
<div class="modal fade" id="supportTicketModal" tabindex="-1" aria-labelledby="supportTicketModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title" id="supportTicketModalLabel"><i class="fa-solid fa-headset me-2"></i> @(isEnglish ? "Create Support Ticket" : "Destek Talebi Oluştur")</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <form id="supportTicketForm">
                    <div class="mb-3">
                        <label for="supportSummary" class="form-label fw-semibold">@(isEnglish ? "Summary / Description" : "Özet / Açıklama")</label>
                        <textarea class="form-control border-secondary-subtle" id="supportSummary" rows="4" placeholder="@(isEnglish ? "Briefly describe your issue or request..." : "Sorununuzu veya talebinizi kısaca açıklayın...")" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="supportPriority" class="form-label fw-semibold">@(isEnglish ? "Priority Level" : "Öncelik Derecesi")</label>
                        <select class="form-select border-secondary-subtle" id="supportPriority" required>
                            <option value="Low">@(isEnglish ? "Low" : "Düşük (Low)")</option>
                            <option value="Average" selected>@(isEnglish ? "Average" : "Orta (Average)")</option>
                            <option value="High">@(isEnglish ? "High" : "Yüksek (High)")</option>
                        </select>
                    </div>
                    <input type="hidden" id="supportInventoryId" />
                    <input type="hidden" id="supportLink" />
                </form>
            </div>
            <div class="modal-footer bg-light border-0 py-3">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">@(isEnglish ? "Cancel" : "İptal")</button>
                <button type="button" class="btn btn-primary px-4" id="btnSubmitSupportTicket">
                    <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true" id="supportSubmitSpinner"></span>
                    <i class="fa-solid fa-paper-plane me-1" id="supportSubmitIcon"></i> @(isEnglish ? "Submit" : "Gönder")
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta3/dist/js/adminlte.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const helpBtn = document.getElementById("floatingHelpButton");
    const helpLink = document.getElementById("createSupportTicketLink");
    const supportModalEl = document.getElementById("supportTicketModal");
    if (!supportModalEl) return;
    
    const isEnglish = @(isEnglish ? "true" : "false");
    const supportModal = new bootstrap.Modal(supportModalEl);
    
    // Add hover scale effect to floating button
    if (helpBtn) {
        helpBtn.addEventListener("mouseenter", () => helpBtn.style.transform = "scale(1.1)");
        helpBtn.addEventListener("mouseleave", () => helpBtn.style.transform = "scale(1)");
    }
    
    function openSupportModal(e) {
        if (e) e.preventDefault();
        
        // Reset form
        document.getElementById("supportSummary").value = "";
        document.getElementById("supportPriority").value = "Average";
        
        // Capture current full link
        document.getElementById("supportLink").value = window.location.href;
        
        // Try to capture InventoryId from URL
        const pathSegments = window.location.pathname.split('/');
        const isInventoryDetails = pathSegments.length >= 4 && pathSegments[1].toLowerCase() === 'inventory' && pathSegments[2].toLowerCase() === 'details';
        const inventoryId = isInventoryDetails ? pathSegments[3] : "";
        document.getElementById("supportInventoryId").value = inventoryId;
        
        supportModal.show();
    }
    
    if (helpBtn) helpBtn.addEventListener("click", openSupportModal);
    if (helpLink) helpLink.addEventListener("click", openSupportModal);
    
    const btnSubmit = document.getElementById("btnSubmitSupportTicket");
    if (btnSubmit) {
        btnSubmit.addEventListener("click", async function () {
            const summary = document.getElementById("supportSummary").value.trim();
            const priority = document.getElementById("supportPriority").value;
            const inventoryId = document.getElementById("supportInventoryId").value || null;
            const link = document.getElementById("supportLink").value;
            
            if (!summary) {
                alert(isEnglish ? "Please fill in the summary/description field." : "Lütfen özet/açıklama alanını doldurun.");
                return;
            }
            
            const spinner = document.getElementById("supportSubmitSpinner");
            const icon = document.getElementById("supportSubmitIcon");
            
            btnSubmit.disabled = true;
            spinner.classList.remove("d-none");
            icon.classList.add("d-none");
            
            try {
                const response = await fetch("/Support/CreateTicket", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        Summary: summary,
                        Priority: priority,
                        InventoryId: inventoryId,
                        Link: link
                    })
                });
                
                const result = await response.json();
                if (response.ok && result.success) {
                    supportModal.hide();
                    alert(isEnglish ? "Your support ticket has been successfully created and uploaded to cloud storage!" : "Destek talebiniz başarıyla oluşturuldu ve bulut depolamaya yüklendi!");
                } else {
                    alert((isEnglish ? "Error: " : "Hata: ") + (result.message || (isEnglish ? "Could not create support ticket." : "Destek talebi oluşturulamadı.")));
                }
            } catch (err) {
                alert((isEnglish ? "A network error occurred: " : "Bir ağ hatası oluştu: ") + err.message);
            } finally {
                btnSubmit.disabled = false;
                spinner.classList.add("d-none");
                icon.classList.remove("d-none");
            }
        });
    }
});
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

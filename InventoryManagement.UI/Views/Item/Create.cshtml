@model ItemCreatePageViewModel
@{
    ViewData["Title"] = $"{Html.T("title", "Add Item to")} {Model.InventoryTitle}";
}
<div class="item-context-banner mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h4 class="mb-1">@Html.T("banner.title", "Adding item to:") @Model.InventoryTitle</h4>
            <div>@Html.T("banner.category", "Inventory category:") @Model.CategoryName · @Html.T("banner.access", "Write access:") @(Model.CanWriteItems ? Html.T("banner.allowed", "Allowed") : Html.T("banner.denied", "Not allowed"))</div>
        </div>
        <a class="btn btn-light" asp-controller="Inventory" asp-action="Details" asp-route-id="@Model.InventoryId">@Html.T("actions.back", "Back to inventory")</a>
    </div>
</div>
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header"><h5 class="mb-0">@Html.T("create.title", "Bulk item create")</h5></div>
            <div class="card-body">
                @if (!Model.CanWriteItems)
                {
                    <div class="alert alert-warning mb-0">@Html.T("create.denied", "You do not have permission to add items to this inventory.")</div>
                }
                else
                {
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="InventoryId" type="hidden" />
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h6 class="mb-1">@Html.T("create.itemsTitle", "Items to create")</h6>
                                <div class="small text-muted">@Html.T("create.itemsHelp", "Add one or many item names, then continue straight into field value entry.")</div>
                            </div>
                            <button class="btn btn-outline-primary btn-sm" type="button" id="addItemRowButton">
                                <i class="fa-solid fa-plus me-1"></i>@Html.T("create.addRow", "Add row")
                            </button>
                        </div>
                        <div id="bulkItemRows" class="d-grid gap-3">
                            @for (var i = 0; i < Model.ItemRows.Count; i++)
                            {
                                <div class="bulk-item-row">
                                    <div class="input-group">
                                        <span class="input-group-text">@Html.T("create.name", "Name")</span>
                                        <input asp-for="ItemRows[i].ItemName" class="form-control" placeholder="@Html.T("create.namePlaceholder", "Item name")" />
                                        <button class="btn btn-outline-danger remove-item-row" type="button"><i class="fa-solid fa-trash"></i></button>
                                    </div>
                                </div>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.HelperText))
                        {
                            <div class="alert alert-light border mt-3 mb-0">@Model.HelperText</div>
                        }
                        <button class="btn btn-success mt-3" type="submit">@Html.T("create.submit", "Create items")</button>
                    </form>
                    <template id="bulkItemRowTemplate">
                        <div class="bulk-item-row">
                            <div class="input-group">
                                <span class="input-group-text">@Html.T("create.name", "Name")</span>
                                <input name="ItemRows[__index__].ItemName" class="form-control" placeholder="@Html.T("create.namePlaceholder", "Item name")" />
                                <button class="btn btn-outline-danger remove-item-row" type="button"><i class="fa-solid fa-trash"></i></button>
                            </div>
                        </div>
                    </template>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header"><h5 class="mb-0">@Html.T("preview.title", "Preview")</h5></div>
            <div class="card-body">
                <div class="preview-panel p-3">
                    <div class="text-muted small">@Html.T("preview.inventory", "Inventory")</div>
                    <h5>@Model.InventoryTitle</h5>
                    <div class="text-muted small">@Html.T("preview.fields", "Field setup")</div>
                    <p class="mb-2">@Model.InventoryFields.Count @Html.T("preview.fieldCount", "field(s) currently defined for this inventory.")</p>
                    @if (Model.InventoryFields.Count > 0)
                    {
                        <ul class="small mb-0 ps-3">
                        @foreach (var field in Model.InventoryFields.OrderBy(x => x.DisplayOrder).Take(6))
                        {
                            <li>@field.Name (@field.FieldType)</li>
                        }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
